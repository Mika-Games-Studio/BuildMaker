* text=auto
*.cs text diff=csharp
*.csproj text
*.slnx text
*.props text
*.json text
*.md text
*.bat text eol=crlf
*.ps1 text eol=crlf

# Scripts de shell e unidades do systemd sao lidos pelo Linux: CRLF quebra o
# shebang ("bad interpreter: /usr/bin/env bash^M") e as diretivas da unidade.
*.sh text eol=lf
*.service text eol=lf
*.yml text eol=lf
