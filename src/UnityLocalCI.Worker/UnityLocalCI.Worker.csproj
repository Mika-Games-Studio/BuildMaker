<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinForms so existe no Windows: a janela e o instalador ficam aqui. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>unitylocalci.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      O nome que o Windows mostra. Sai daqui, e nao do nome do arquivo: e a
      informacao de versao do executavel que alimenta o Gerenciador de Tarefas
      (tanto a lista de processos quanto a aba Inicializar), as propriedades do
      arquivo e o dialogo do UAC quando ele aparece.

      O arquivo continua UnityLocalCI.exe de proposito. O nome do executavel, o
      do servico do Windows e o da credencial no cofre sao identidade, nao
      rotulo: renomear qualquer um deles quebraria as instalacoes que ja existem
      — o servico nao seria encontrado, a credencial gravada viraria orfa.
    -->
    <AssemblyTitle>BuildMaker</AssemblyTitle>
    <Product>BuildMaker</Product>
    <Company>BSA Tech</Company>
    <Description>CI local para projetos Unity</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <!-- WinExe: sem janela de console atras da interface. O modo servico nao
         precisa de console, e a janela tem a aba de log ao vivo. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UnityLocalCI.App</RootNamespace>
    <AssemblyName>UnityLocalCI</AssemblyName>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnityLocalCI.Core\UnityLocalCI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Os auxiliares internos de tempo e caminho sao testados: e neles que mora
         a protecao contra travamento da janela. -->
    <InternalsVisibleTo Include="UnityLocalCI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="unitylocalci.ico" />

    <!--
      A configuracao modelo viaja dentro do binario.

      O que se distribui e um executavel sozinho, sem pasta ao lado: quando ele
      se instala, precisa criar um appsettings.json do zero no destino, e o
      modelo tem que vir de dentro dele. Ver Instalacao.EscreverConfiguracaoInicial.
    -->
    <EmbeddedResource Include="appsettings.json" LogicalName="UnityLocalCI.appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
