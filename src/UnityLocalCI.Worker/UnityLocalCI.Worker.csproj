<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>unitylocalci.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <!-- WinExe: sem janela de console atras da interface. O modo servico nao
         precisa de console, e a janela tem a aba de log ao vivo. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UnityLocalCI.App</RootNamespace>
    <AssemblyName>UnityLocalCI</AssemblyName>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnityLocalCI.Core\UnityLocalCI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Os auxiliares internos de tempo e caminho sao testados: e neles que mora
         a protecao contra travamento da janela. -->
    <InternalsVisibleTo Include="UnityLocalCI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="unitylocalci.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
