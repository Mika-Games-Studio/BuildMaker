<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BuildMaker.app" />

  <!--
    O programa pede elevacao ao abrir.

    O motivo e pratico: sem elevacao, o Behavior Monitoring do Apex One trata
    este executavel como programa recem-encontrado — sem assinatura de
    fornecedor e com prevalencia 1 nesta maquina — e bloqueia a execucao com um
    dialogo. Elevado, ele passa.

    Nada aqui engana o antivirus. O executavel e o mesmo, no mesmo lugar, com o
    mesmo hash; quem autoriza e o usuario, no dialogo do proprio Windows, com as
    credenciais dele. O que muda e o nivel de confianca declarado — e declarar
    que um programa precisa de privilegio e o oposto de esconder o que ele e.

    O custo e real e vale ser dito: o UAC aparece a cada abertura manual, as
    builds do Unity passam a rodar elevadas, e o inicio automatico deixa de
    funcionar por HKCU\...\Run — o Windows nao executa programa elevado por ali.
    Por isso o instalador passou a registrar uma tarefa agendada com privilegio
    mais alto, que sobe no logon sem dialogo nenhum.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11. Sem isto o Windows finge ser o 8 para APIs de versao. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>
</assembly>
